<h1 id='reference'>Reference</h1><h2 id='reference-booqable-json'><code>booqable.json</code></h2>
<p>Schema for the configuration file that defines Booqable apps.</p>
<div class="highlight"><pre class="highlight json tab-json"><code><span class="p">{</span><span class="w">
  </span><span class="nl">"$schema"</span><span class="p">:</span><span class="w"> </span><span class="s2">"https://developers.booqable.com/schemas/app-0-2-0.json#"</span><span class="p">,</span><span class="w">
  </span><span class="nl">"id"</span><span class="p">:</span><span class="w"> </span><span class="s2">"liquid_conf"</span><span class="p">,</span><span class="w">
  </span><span class="nl">"version"</span><span class="p">:</span><span class="w"> </span><span class="s2">"1.0.0"</span><span class="p">,</span><span class="w">
  </span><span class="nl">"name"</span><span class="p">:</span><span class="w"> </span><span class="s2">"MyApp"</span><span class="p">,</span><span class="w">
  </span><span class="nl">"author"</span><span class="p">:</span><span class="w"> </span><span class="s2">"Booqable"</span><span class="p">,</span><span class="w">
  </span><span class="nl">"app_store"</span><span class="p">:</span><span class="w"> </span><span class="p">{</span><span class="w"> </span><span class="err">/*</span><span class="w"> </span><span class="err">AppStoreInfo</span><span class="w"> </span><span class="err">*/</span><span class="w"> </span><span class="p">},</span><span class="w">
  </span><span class="nl">"plans"</span><span class="p">:</span><span class="w"> </span><span class="p">[</span><span class="w"> </span><span class="err">/*</span><span class="w"> </span><span class="err">...</span><span class="w"> </span><span class="err">*/</span><span class="w"> </span><span class="p">],</span><span class="w">
  </span><span class="nl">"configuration_page"</span><span class="p">:</span><span class="w"> </span><span class="p">{</span><span class="w"> </span><span class="err">/*</span><span class="w"> </span><span class="err">ConfigurationPage</span><span class="w"> </span><span class="err">*/</span><span class="w"> </span><span class="p">},</span><span class="w">
  </span><span class="nl">"iframe_page"</span><span class="p">:</span><span class="w"> </span><span class="p">{</span><span class="w"> </span><span class="err">/*</span><span class="w"> </span><span class="err">IframePage</span><span class="w"> </span><span class="err">*/</span><span class="w"> </span><span class="p">},</span><span class="w">
  </span><span class="nl">"tracking_script"</span><span class="p">:</span><span class="w"> </span><span class="p">{</span><span class="w"> </span><span class="err">/*</span><span class="w"> </span><span class="err">TrackingScript</span><span class="w"> </span><span class="err">*/</span><span class="w"> </span><span class="p">},</span><span class="w">
  </span><span class="nl">"theme_blocks"</span><span class="p">:</span><span class="w"> </span><span class="p">[</span><span class="w"> </span><span class="err">/*</span><span class="w"> </span><span class="err">...</span><span class="w"> </span><span class="err">*/</span><span class="w"> </span><span class="p">],</span><span class="w">
  </span><span class="nl">"oauth"</span><span class="p">:</span><span class="w"> </span><span class="p">{</span><span class="w"> </span><span class="err">/*</span><span class="w"> </span><span class="err">OauthConfig</span><span class="w"> </span><span class="err">*/</span><span class="w"> </span><span class="p">},</span><span class="w">
  </span><span class="nl">"base_url"</span><span class="p">:</span><span class="w"> </span><span class="s2">"https://example.com"</span><span class="p">,</span><span class="w">
  </span><span class="nl">"payments"</span><span class="p">:</span><span class="w"> </span><span class="p">{</span><span class="w"> </span><span class="err">/*</span><span class="w"> </span><span class="err">PaymentsConfig</span><span class="w"> </span><span class="err">*/</span><span class="w"> </span><span class="p">}</span><span class="w">
</span><span class="p">}</span><span class="w">
</span></code></pre></div>
<table><thead>
<tr>
<th>Name</th>
<th>Type</th>
<th>Required</th>
<th>Description</th>
</tr>
</thead><tbody>
<tr>
<td><code>$schema</code></td>
<td>constant: <code>&quot;https://developers.booqable.com/schemas/app-0-2-0.json#&quot;</code></td>
<td>true</td>
<td>Schema version for the app configuration.</td>
</tr>
<tr>
<td><code>id</code></td>
<td>string</td>
<td>true</td>
<td>Unique identifier for the app, used internally.</td>
</tr>
<tr>
<td><code>version</code></td>
<td>string</td>
<td>true</td>
<td>Version number or status of the app.</td>
</tr>
<tr>
<td><code>name</code></td>
<td>string</td>
<td>true</td>
<td>Internal name for the app, not shown to end users.</td>
</tr>
<tr>
<td><code>author</code></td>
<td>string</td>
<td>true</td>
<td>Name of the app developer or company.</td>
</tr>
<tr>
<td><code>app_store</code></td>
<td><a href="#reference-appstoreinfo"><code>AppStoreInfo</code></a></td>
<td>true</td>
<td></td>
</tr>
<tr>
<td><code>plans</code></td>
<td>array of <a href="#reference-appplan"><code>AppPlan</code></a></td>
<td>false</td>
<td>Subscription plans for the app.</td>
</tr>
<tr>
<td><code>configuration_page</code></td>
<td><a href="#reference-configurationpage"><code>ConfigurationPage</code></a></td>
<td>false</td>
<td>Optional configuration page content (banners, forms, guides, iframes). Omit the key when the app has no configuration page.</td>
</tr>
<tr>
<td><code>iframe_page</code></td>
<td><a href="#reference-iframepage"><code>IframePage</code></a></td>
<td>false</td>
<td>Settings for apps that are operated through an embedded external page.</td>
</tr>
<tr>
<td><code>tracking_script</code></td>
<td><a href="#reference-trackingscript"><code>TrackingScript</code></a></td>
<td>false</td>
<td>Settings for apps that provide tracking scripts meant to be installed in store pages.</td>
</tr>
<tr>
<td><code>theme_blocks</code></td>
<td>array of <a href="#reference-themeblock"><code>ThemeBlock</code></a></td>
<td>false</td>
<td>Website blocks provided by this app for use in the website editor.</td>
</tr>
<tr>
<td><code>oauth</code></td>
<td><a href="#reference-oauthconfig"><code>OauthConfig</code></a></td>
<td>false</td>
<td>OAuth integration for apps that require Booqable to grant access on behalf of the user.</td>
</tr>
<tr>
<td><code>base_url</code></td>
<td>string</td>
<td>false</td>
<td>Base URL to use when providing relative URLs elsewhere in this configuration file.</td>
</tr>
<tr>
<td><code>payments</code></td>
<td><a href="#reference-paymentsconfig"><code>PaymentsConfig</code></a></td>
<td>false</td>
<td>Payment integration for apps that process charges, authorizations, and refunds.</td>
</tr>
</tbody></table>
<h2 id='reference-appstoreinfo'><code>AppStoreInfo</code></h2>
<p>Information about the app to display in the app store.</p>
<div class="highlight"><pre class="highlight json tab-json"><code><span class="p">{</span><span class="w">
  </span><span class="nl">"title"</span><span class="p">:</span><span class="w"> </span><span class="p">{</span><span class="w"> </span><span class="err">/*</span><span class="w"> </span><span class="err">LocalizableString</span><span class="w"> </span><span class="err">*/</span><span class="w"> </span><span class="p">},</span><span class="w">
  </span><span class="nl">"description"</span><span class="p">:</span><span class="w"> </span><span class="p">{</span><span class="w"> </span><span class="err">/*</span><span class="w"> </span><span class="err">AppStoreDescription</span><span class="w"> </span><span class="err">*/</span><span class="w"> </span><span class="p">},</span><span class="w">
  </span><span class="nl">"categories"</span><span class="p">:</span><span class="w"> </span><span class="p">[</span><span class="w"> </span><span class="err">/*</span><span class="w"> </span><span class="err">...</span><span class="w"> </span><span class="err">*/</span><span class="w"> </span><span class="p">],</span><span class="w">
  </span><span class="nl">"card_image"</span><span class="p">:</span><span class="w"> </span><span class="p">{</span><span class="w"> </span><span class="err">/*</span><span class="w"> </span><span class="err">AssetReference</span><span class="w"> </span><span class="err">*/</span><span class="w"> </span><span class="p">},</span><span class="w">
  </span><span class="nl">"icon"</span><span class="p">:</span><span class="w"> </span><span class="p">{</span><span class="w"> </span><span class="err">/*</span><span class="w"> </span><span class="err">AssetReference</span><span class="w"> </span><span class="err">*/</span><span class="w"> </span><span class="p">},</span><span class="w">
  </span><span class="nl">"features"</span><span class="p">:</span><span class="w"> </span><span class="p">[</span><span class="w"> </span><span class="err">/*</span><span class="w"> </span><span class="err">...</span><span class="w"> </span><span class="err">*/</span><span class="w"> </span><span class="p">],</span><span class="w">
  </span><span class="nl">"website"</span><span class="p">:</span><span class="w"> </span><span class="p">{</span><span class="w"> </span><span class="err">/*</span><span class="w"> </span><span class="err">Link</span><span class="w"> </span><span class="err">*/</span><span class="w"> </span><span class="p">},</span><span class="w">
  </span><span class="nl">"youtube"</span><span class="p">:</span><span class="w"> </span><span class="s2">"4tDyXghOQbI"</span><span class="p">,</span><span class="w">
  </span><span class="nl">"setup_minutes"</span><span class="p">:</span><span class="w"> </span><span class="mi">2</span><span class="p">,</span><span class="w">
  </span><span class="nl">"support"</span><span class="p">:</span><span class="w"> </span><span class="p">{</span><span class="w"> </span><span class="err">/*</span><span class="w"> </span><span class="err">AppStoreSupport</span><span class="w"> </span><span class="err">*/</span><span class="w"> </span><span class="p">}</span><span class="w">
</span><span class="p">}</span><span class="w">
</span></code></pre></div>
<table><thead>
<tr>
<th>Name</th>
<th>Type</th>
<th>Required</th>
<th>Description</th>
</tr>
</thead><tbody>
<tr>
<td><code>title</code></td>
<td><a href="#reference-localizablestring"><code>LocalizableString</code></a></td>
<td>true</td>
<td></td>
</tr>
<tr>
<td><code>description</code></td>
<td><a href="#reference-appstoredescription"><code>AppStoreDescription</code></a></td>
<td>true</td>
<td></td>
</tr>
<tr>
<td><code>categories</code></td>
<td>array of string</td>
<td>false</td>
<td>Category classification for organizing apps in the app store.</td>
</tr>
<tr>
<td><code>card_image</code></td>
<td><a href="#reference-assetreference"><code>AssetReference</code></a></td>
<td>true</td>
<td></td>
</tr>
<tr>
<td><code>icon</code></td>
<td><a href="#reference-assetreference"><code>AssetReference</code></a></td>
<td>true</td>
<td></td>
</tr>
<tr>
<td><code>features</code></td>
<td>array of <a href="#reference-localizablestring"><code>LocalizableString</code></a></td>
<td>false</td>
<td>Bulleted list of key features shown on the app&#39;s store page.</td>
</tr>
<tr>
<td><code>website</code></td>
<td><a href="#reference-link"><code>Link</code></a></td>
<td>false</td>
<td>Product or marketing website link shown in the app&#39;s store page.</td>
</tr>
<tr>
<td><code>youtube</code></td>
<td>string</td>
<td>false</td>
<td>YouTube video ID for an embedded overview/promo video to be shown in the app&#39;s store page.</td>
</tr>
<tr>
<td><code>setup_minutes</code></td>
<td>integer</td>
<td>false</td>
<td>Estimated time in minutes to install and set up the app.</td>
</tr>
<tr>
<td><code>support</code></td>
<td><a href="#reference-appstoresupport"><code>AppStoreSupport</code></a></td>
<td>false</td>
<td></td>
</tr>
</tbody></table>
